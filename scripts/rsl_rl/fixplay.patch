+def export_encoder_as_jit(encoder, path):
+    """Export the MLP_Encoder's inner nn.Sequential (velocity estimator) as a
+    TorchScript .pt file, analogous to export_policy_as_jit for the actor.
+    Only `encoder.encoder` (the plain nn.Sequential) is scripted -- not the
+    MLP_Encoder wrapper class itself, which has dynamic attributes/methods
+    (encode(), inference(), self.encoder_out, self.output_detach) that
+    torch.jit.script cannot reliably trace. This mirrors how
+    export_policy_as_jit scripts actor_critic.actor rather than actor_critic.
+    Lets sim2sim consume a single .pt pair (policy.pt + encoder.pt) instead of
+    mixing in onnx, while export_mlp_as_onnx() below remains available for the
+    sim2real deployment stack.
+    """
+    os.makedirs(path, exist_ok=True)
+    path = os.path.join(path, "encoder.pt")
+    model = copy.deepcopy(encoder.encoder).to("cpu")
+    model.eval()
+    traced_script_module = torch.jit.script(model)
+    traced_script_module.save(path)
